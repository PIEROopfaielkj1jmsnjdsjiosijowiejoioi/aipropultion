{
  "name": "ai-propulsion-heartbeat",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_WORKSPACE",
        "class_name": "AgentWorkspace"
      }
